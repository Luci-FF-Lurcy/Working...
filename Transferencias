SELECT
    COUNT(*) AS TOTAL_REGISTROS,

    COUNT(DISTINCT SUBSCRIBER_ID)
        AS SERVICIOS_UNICOS,

    COUNT(DISTINCT IDENTIFICACION)
        AS CLIENTES_UNICOS,

    SUM(CASE
        WHEN SUBSCRIBER_ID IS NULL THEN 1
        ELSE 0
    END) AS SIN_SUBSCRIBER_ID,

    SUM(CASE
        WHEN IDENTIFICACION IS NULL THEN 1
        ELSE 0
    END) AS SIN_IDENTIFICACION

FROM SANDBOX.SAC_RET.FIJO_FINAL_ABONADOS_BAJAS_IG

WHERE GRUPO_ORIGEN = 'BAJAS'
  AND TIPO_BAJA = 'VOLUNTARIA'
  AND FECHA_PROCESO = '202610';
