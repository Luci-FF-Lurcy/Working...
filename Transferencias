
/*###############################################################################################################################################################
#####################################################            INFORME GERENCIAL            #####################################################################
############################################################################################################################################################### */

SELECT * FROM(
SELECT CATEGORIZACION_TIER_2, CATEGORIZACION_TIER_3,PRODUCTO,
       SUBCLASIFICACION_INFORME_GERENCIAL, SUBCLASIFICACION_TIPO_BAJA
INFORME_GERENCIAL,
TIPOLOGIA,
USUARIO_FINAL,
CLASIFICAR_TIPO_BAJA,
TIEMPO_VIDA
		,DESCRIPCION_FORMA_PAGO,
        PROVINCIA, 
        TIP_MOTIVO_ATENCION,
        BASE,
        ABONADOS_REALES,
        SEGMENTO_CLIENTE,
        CANAL_FINAL,
        TOTAL_SERVICIOS AS SERVICIOS, 
        codigo_sucursal,
        tipo_transaccion,
        CANAL_F,
        DATE(FECHA_baja) AS FECHA_baja,
        DATE(FECHA_ALTA) AS FECHA_ALTA,
        FECHA_PROCESO, 
        SUBSCRIBER_ID, 
        IDENTIFICACION, 
        ID_IDENTIFICACION, 
        ID_IDENTIFICACION_GRUPO, 
        TIPO_BAJA, 
        TECNOLOGIA,
        FAMILIA, 
        NODO_FINAL, 
        TIPO_MOTIVO_ATENCION, 
        GRUPO_ORIGEN, 
        TIPO_PAQUETE, 
        VALOR_RECURRENTE, 
        ORIGEN,
        CANAL_VENTA_EJECUTIVO, 
        TARIFA_BASICA,
        GF_BF,
        CASE 
            WHEN TECNOLOGIA = 'GPON' THEN REGION1 
            WHEN TECNOLOGIA = 'HFC' THEN REGION2 
        END AS REGION_LIBERADO,
        CASE 
            WHEN TECNOLOGIA = 'GPON' THEN OLT1 
            WHEN TECNOLOGIA = 'HFC' THEN OLT2 
        END AS OLT_LIBERADO,
        CASE 
            WHEN TECNOLOGIA = 'GPON' THEN CLUSTE1 
            WHEN TECNOLOGIA = 'HFC' THEN CLUSTE2 
        END AS CLUSTE_LIBERADO,
        CASE 
            WHEN TECNOLOGIA = 'GPON' THEN UPPER(CIUDAD1) 
            WHEN TECNOLOGIA = 'HFC' THEN UPPER(CIUDAD2) 
        END AS CIUDAD_LIBERADO, 
        CASE 
            WHEN TECNOLOGIA = 'GPON' THEN UPPER(DPHP) 
            WHEN TECNOLOGIA = 'HFC' THEN UPPER(DPHP2) 
        END AS TOTAL_HP, 
        CAST(
            CASE 
                WHEN TECNOLOGIA = 'GPON' THEN DPHP 
                WHEN TECNOLOGIA = 'HFC' THEN DPHP2 
            END AS INT
        ) AS HOME_PASS_F,
        COINCIDENCIA_ALTA_BAJA,  
        NULL AS FECHA_PROCESOF,
        NULL AS STATUS, 
        NULL AS GESTION
    FROM (
        SELECT  a.CATEGORIZACION_TIER_2, a.CATEGORIZACION_TIER_3,A. PRODUCTO, A.SUBCLASIFICACION_INFORME_GERENCIAL,
		A.SUBCLASIFICACION_TIPO_BAJA,
A.TIP_MOTIVO_ATENCION,
A.INFORME_GERENCIAL,
A.TIPOLOGIA,
A.USUARIO_FINAL,
A.CLASIFICAR_TIPO_BAJA,
A.TIEMPO_VIDA
		,A.DESCRIPCION_FORMA_PAGO,
            A.PROVINCIA, A.BASE, A.ABONADOS_REALES, A.SEGMENTO_CLIENTE, A.CANAL_FINAL, A.TOTAL_SERVICIOS,
            A.codigo_sucursal, A.tipo_transaccion, A.CANAL_F, A.FECHA_ALTA, A.FECHA_baja, A.FECHA_PROCESO, A.SUBSCRIBER_ID,
            A.IDENTIFICACION, A.ID_IDENTIFICACION, A.ID_IDENTIFICACION_GRUPO, A.TIPO_BAJA, A.TECNOLOGIA, A.CANAL_VENTA_EJECUTIVO,
            A.OFFERING_INST_ID, A.TARIFA_BASICA, A.FAMILIA, A.NODO_FINAL, A.TIPO_MOTIVO_ATENCION, A.GRUPO_ORIGEN, A.TIPO_PAQUETE,
            A.VALOR_RECURRENTE, A.ORIGEN,
            C.REGION_L AS REGION1, C.OLT AS OLT1, C.CLUSTE AS CLUSTE1, C.CIUDAD AS CIUDAD1, C.DISPONIBILIDAD_HP_TOTAL AS DPHP,
            D.REGION AS REGION2, D.PARROQUIA_HUB AS OLT2, D.NODO AS CLUSTE2, D.GF_BF, D.CIUDAD_HUB AS CIUDAD2, D.DISPONIBILIDAD_HP_TOTAL AS DPHP2,
            A.COINCIDENCIA_ALTA_BAJA
        FROM SANDBOX.SAC_RET.FIJO_FINAL_ABONADOS_BAJAS_IG A  
        LEFT JOIN (
            SELECT 
                CASE 
                    WHEN REGION = 'R1' THEN 'REGION 1'
                    WHEN REGION = 'R2' THEN 'REGION 2' 
                END AS REGION_L, 
                OLT, CLUSTE, CIUDAD, DISPONIBILIDAD_HP_TOTAL,
                ROW_NUMBER() OVER (PARTITION BY CLUSTE ORDER BY FECHA_PROCESO DESC) AS RNG
            FROM OID_DB.MAPEO.TIC_HPS_LIBERADAS_GPON 
            WHERE FECHA_PROCESO = (
                SELECT MAX(FECHA_PROCESO) FROM OID_DB.MAPEO.TIC_HPS_LIBERADAS_GPON
            )
        ) C ON (
            A.NODO_FINAL = C.CLUSTE OR 
            SUBSTR(A.NODO_FINAL,1,6) = C.CLUSTE OR 
            SUBSTR(A.NODO_FINAL,4,6) = C.CLUSTE OR 
            SUBSTR(A.NODO_FINAL,1,5) = C.CLUSTE
        ) AND C.RNG = 1
        LEFT JOIN (
            SELECT  
                REGION_HUB AS REGION, PARROQUIA_HUB, NODO, GF_BF, CIUDAD_HUB, DISPONIBILIDAD_HP_TOTAL,
                ROW_NUMBER() OVER (PARTITION BY NODO ORDER BY FECHA_PROCESO DESC) AS NFILAY
            FROM OID_DB.MAPEO.TIC_HPS_LIBERADAS_HFC
            WHERE FECHA_PROCESO = (
                SELECT MAX(FECHA_PROCESO) FROM OID_DB.MAPEO.TIC_HPS_LIBERADAS_HFC
            )
        ) D ON (
            A.NODO_FINAL = D.NODO OR 
            SUBSTR(A.NODO_FINAL,1,6) = D.NODO OR 
            SUBSTR(A.NODO_FINAL,4,6) = D.NODO OR 
            SUBSTR(A.NODO_FINAL,1,5) = D.NODO
        ) AND D.NFILAY = 1
   
    ) AS tmp_final
)FINAL

LEFT JOIN 
	(
            SELECT 
                CASE 
                    WHEN ID_NSE = '1' THEN 'Muy Alto'
                    WHEN ID_NSE = '2' THEN 'Alto'
                    WHEN ID_NSE = '3' THEN 'Medio Tipico'
                    WHEN ID_NSE = '4' THEN 'Medio Bajo'
                    WHEN ID_NSE = '5' THEN 'Bajo'
                    ELSE ID_NSE
                END AS CATEGORIA_NSE, 
                ID_RED, FECHA_PROCESO AS FPNS
            FROM OID_DB.OID_DB.OID_RESUMEN_RED_FIJA 
			WHERE FECHA_PROCESO =(
                SELECT MAX(FECHA_PROCESO) FROM OID_DB.OID_DB.OID_RESUMEN_RED_FIJA )
             --FECHA_PROCESO >= '2025-01-31 00:00:00'
        --)
		) NS ON FINAL.NODO_FINAL=NS.ID_RED --AND tmp_final.FECHA_PROCESO=TO_CHAR(NS.FPNS, 'YYYYMM')
--)FINAL

LIMIT 10000;


/*###############################################################################################################################################################
#####################################################            TABLERO_BAJAS_OFICIAL - NUEVO 1            #####################################################################
############################################################################################################################################################### */

SELECT *, 
		CASE
		    WHEN NOMBRE_CICLO IN ('CICLO FMC DIA 26-25 ', 'CICLO 26-25 ', 'CICLO 26-25', 'Ciclo Completo ', 
		                          'CICLO FMC DIA 26-25 ', 'CICLO DIA 26 FECHA MAX PAGO DIA 08 PROXIMO MES ') THEN 'CICLO FMC DIA 26-25'
		    WHEN NOMBRE_CICLO IN ('CICLO 11-10 ', 'CICLO FMC DIA 11-10 ', 'Ciclo 2 Mensual ', 'Ciclo Datos Autoconsumo ', 
		        				  'Ciclo 2 ', 'CICLO FMC DIA 11-10 ', 'CICLO FMC DIA 11-10 ', 'CICLO DIA 11 FECHA MAX PAGO DIA 23 ') THEN 'CICLO FMC DIA 11-10'
		    WHEN NOMBRE_CICLO IN ('CICLO FMC DIA 24-23 ', 'CICLO 23-24 ', 'CICLO FMC DIA 24-23 ','CICLO FMC DIA 24-23 ', 'CICLO DIA 24 FECHA MAX PAGO DIA 06 PROXIMO MES ') THEN 'CICLO FMC DIA 24-23'
		    WHEN NOMBRE_CICLO IN ('CICLO DIA 2-1 ', 'CICLO FMC DIA 2-1 ', 'CICLO FMC DIA 2-1 ', 'CICLO DIA 2 FECHA MAX PAGO DIA 14 ', 'CICLO DIA 2 FECHA MAX PAGO DIA 15 ') THEN 'CICLO FMC DIA 2-1'
		    WHEN NOMBRE_CICLO IN ('CICLO FMC DIA 8-7 ', 'CICLO DIA 8 FECHA MAX PAGO DIA 20 ') THEN 'CICLO FMC DIA 8-7'
		    WHEN NOMBRE_CICLO IN ('CICLO FMC DIA 15-14 ', 'CICLO DIA 15-14 ', 'CICLO DIA 15 FECHA MAX PAGO DIA 27 ','CICLO DIA 15 FECHA MAX PAGO DIA 26 ') THEN 'CICLO FMC DIA 15-14'
		    WHEN NOMBRE_CICLO IN ('CICLO FMC DIA 19-18 ', '29 ') THEN 'CICLO FMC DIA 19-18'
		    WHEN NOMBRE_CICLO IN ('CICLO FMC DIA 21-20 ', '30 ') THEN 'CICLO FMC DIA 21-20'
		    WHEN NOMBRE_CICLO IN ('CICLO FMC DIA 28-27 ', '31 ') THEN 'CICLO FMC DIA 28-27'
		    WHEN NOMBRE_CICLO IN ('CICLO FMC DIA 17-16 ', '28 ') THEN 'CICLO FMC DIA 17-16'
		    WHEN NOMBRE_CICLO IN ('CICLO FMC DIA 13-12 ', '27 ') THEN 'CICLO FMC DIA 13-12'
		    WHEN NOMBRE_CICLO IN ('CICLO FMC DIA 4-3 ', '25 ') THEN 'CICLO FMC DIA 4-3'
		    WHEN NOMBRE_CICLO IN ('CICLO FMC DIA 6-5 ', '26 ') THEN 'CICLO FMC DIA 6-5'   ELSE '-' 
		END AS CICLO_FINAL
FROM (    SELECT   A.*,
			       B.CAMPANIA_SAC,
				   C.CAMPANIA_SAC_2
			  FROM (  SELECT *,
						       CASE 
						            WHEN ID_IDENTIFICACION='CEDULA'     AND LENGTH(IDENTIFICACION)<10 THEN '*'||IDENTIFICACION 
						            WHEN ID_IDENTIFICACION='RUC'        AND LENGTH(IDENTIFICACION)<13 THEN '*'||IDENTIFICACION 
						            WHEN ID_IDENTIFICACION='PASAPORTE'  AND LENGTH(IDENTIFICACION)<10 THEN '*'||IDENTIFICACION   ELSE IDENTIFICACION
						        END ID_SCANDAL,
						       CASE
						            WHEN TIPO_MOTIVO_ATENCION ='Control de Vta Escenario 3' THEN 'SI' 
						            WHEN TIPO_MOTIVO_ATENCION ='Control de Vta Escenario 2' THEN 'SI' 
						            WHEN TIPO_MOTIVO_ATENCION ='Control de Vta Escenario 1' THEN 'SI' ELSE 'NO'
						        END MALA_VENTA  
								
						  FROM (  SELECT B.*,
						                 C.OFICINA_EJECUTIVO     AS OFICINA_EJECUTIVO_2,
						                 C.CANAL_VENTA_EJECUTIVO AS CANAL_VENTA_EJECUTIVO_2,
						                 C.MARCA AS MARCA_INV,
						                 C.MODELO AS MODELO_INV,
						                 C.ANCHO_BANDA_INV
								   FROM ( SELECT   
								                  FECHA_PROCESO,
												  SUBSCRIBER_ID,
											      IDENTIFICACION,
											      PRODUCTO,
											      USUARIO_REGISTRO,
											      NUM_SERVICIOS,
											      TECNOLOGIA,
											      OFICINA_EJECUTIVO,    
												  DESCRIPCION_PLAN,    
												  DESCRIPCION_FORMA_PAGO,
											      CANTON,    
												  PID_NUEVO,
											      SEGMENTO,
											      SEGMENTO_CLIENTE,
											      ORIGEN,
											      TIPO_SERVICIO,    
												  NOMBRE_COMPLETO,    
												  CLIENTE_PRUEBA,
											      MODALIDAD,    
												  TIPOTRANSACCION,
											      PROYECTO,
											      CODIGO_SUCURSAL,
											      CODIGO_CLIENTE,
											      NOMBRE_BUNDLE,    
												  ALTA_DIFERIDA,    
												  TARIFA_BASICA,
											      ANCHO_BANDA, -- BW,
											      NUMERO_SERVICIO,
											      CUENTA,
											      FECHA_INSTALACION,
											      EJECUTIVO,
											      FECHA_INGRESO,    
												  TIPO_MOTIVO_ATENCION,
											      FECHA_CANCELACION,      
											      TIPO_SOT,
											      CANAL_VENTA_EJECUTIVO,
											      REGION_EJECUTIVO,
											      SERIE,    
												  USUARIO_ULTIMA_TRANSACCION,    
												  ID_PLAN,
											      NODO,
											      CODIGO_CLUSTER,
											      NOMBRE_CICLO,
											      SOT,
											      ESTADO_SOT,
											      CASE
													   WHEN ID_IDENTIFICACION = 'Cedula de Identidad' THEN 'CEDULA'
													   WHEN ID_IDENTIFICACION = 'Pasaporte'           THEN 'PASAPORTE'
											           WHEN ID_IDENTIFICACION = 'Ruc'                 THEN 'RUC'   ELSE  UPPER(ID_IDENTIFICACION) 
												  END AS ID_IDENTIFICACION,
											      CASE
											           WHEN SUBPRODUCTO_HOMOLOGADO = 'INTERNET'                                   THEN  'Internet'
											           WHEN SUBPRODUCTO_HOMOLOGADO = 'TV' AND TECNOLOGIA = 'DTH'                  THEN  'TV DTH'
											           WHEN SUBPRODUCTO_HOMOLOGADO = 'Television' AND TECNOLOGIA = 'DTH'          THEN  'TV DTH'
											           WHEN SUBPRODUCTO_HOMOLOGADO = 'TV' AND TECNOLOGIA = 'HFC'                  THEN  'Television'
											           WHEN SUBPRODUCTO_HOMOLOGADO = 'IPTV' AND TECNOLOGIA = 'DTH'                THEN  'TV DTH'
											           WHEN SUBPRODUCTO_HOMOLOGADO = 'OTT'                                        THEN  'Television'
											           WHEN SUBPRODUCTO_HOMOLOGADO = 'IPTV'                                       THEN  'Television'
											           WHEN SUBPRODUCTO_HOMOLOGADO = 'TV' AND TECNOLOGIA = 'GPON'                 THEN  'Television'
											           WHEN SUBPRODUCTO_HOMOLOGADO = 'LINEA FIJA'                                 THEN  'Telefonia'
											           WHEN SUBPRODUCTO_HOMOLOGADO = 'ADICIONALES INTERNET'                       THEN  'Componentes Adicionales de Internet'
											           WHEN SUBPRODUCTO_HOMOLOGADO = 'ADICIONALES TV' AND TECNOLOGIA = 'DTH'      THEN  'Servicios Adicionales de Television DTH'
											           WHEN SUBPRODUCTO_HOMOLOGADO = 'ADICIONALES TV' AND TECNOLOGIA = 'HFC'      THEN  'Servicios Adicionales de Television'                        
											           WHEN SUBPRODUCTO_HOMOLOGADO = 'ADICIONALES TELEFONIA'                      THEN  'Componentes Adicionales de Telefonía' ELSE  SUBPRODUCTO_HOMOLOGADO
											       END AS SUBPRODUCTO_HOMOLOGADO,
											      SUBPRODUCTO_HOMOLOGADO AS FAMILIA_ORIG,
											      CASE
												      WHEN TIPO_BUNDLE = '1 PLAY + Internet'                          THEN  '1 PLAY - Internet'
												      WHEN TIPO_BUNDLE = '1 PLAY Internet'                            THEN  '1 PLAY - Internet'
												      WHEN TIPO_BUNDLE = '1 PLAY  Internet'                           THEN  '1 PLAY - Internet'
												      WHEN TIPO_BUNDLE = '1 PLAY + Linea Fija'                        THEN  '1 PLAY - Telefonia'
												      WHEN TIPO_BUNDLE = '1 PLAY Linea Fija'                          THEN  '1 PLAY - Telefonia'
												      WHEN TIPO_BUNDLE = '1 PLAY  Linea Fija'                         THEN  '1 PLAY - Telefonia'
												      WHEN TIPO_BUNDLE = '1 PLAY + Tv'                                THEN  '1 PLAY - Television'
												      WHEN TIPO_BUNDLE = '1 PLAY Tv'                                  THEN  '1 PLAY - Television'
												      WHEN TIPO_BUNDLE = '1 PLAY Iptv'                                THEN  '1 PLAY - Television'
												      WHEN TIPO_BUNDLE = '1 PLAY Ott'                                 THEN  '1 PLAY - Television'
												      WHEN TIPO_BUNDLE = '2 PLAY Internet + Linea Fija'               THEN  '2 PLAY - Internet + Telefonia'
												      WHEN TIPO_BUNDLE = '2 PLAY Internet+Telefonia'                  THEN  '2 PLAY - Internet + Telefonia'
												      WHEN TIPO_BUNDLE = '2 PLAY Internet + Tv'                       THEN  '2 PLAY - Internet + Television'
												      WHEN TIPO_BUNDLE = '2 PLAY Internet+Television'                 THEN  '2 PLAY - Internet + Television'
												      WHEN TIPO_BUNDLE = '2 PLAY Linea Fija + Tv'                     THEN  '2 PLAY - Telefonia + Television'
												      WHEN TIPO_BUNDLE = '2 PLAY Telefonia+Television'                THEN  '2 PLAY - Telefonia + Television'
												      WHEN TIPO_BUNDLE = '2 PLAY Internet + Ott'                      THEN  '2 PLAY - Internet + Television'
												      WHEN TIPO_BUNDLE = '2 PLAY Internet + Iptv'                     THEN  '2 PLAY - Internet + Television'
												      WHEN TIPO_BUNDLE = '3 PLAY Internet + Linea Fija + Tv'          THEN '3 PLAY - Internet + Telefonia + Television'
												      WHEN TIPO_BUNDLE = '3 PLAY Internet+Telefonia+Television + Tv'  THEN '3 PLAY - Internet + Telefonia + Television'
												      WHEN TIPO_BUNDLE = '3 PLAY Internet+Telefonia+Television'       THEN '3 PLAY - Internet + Telefonia + Television'
												      WHEN TIPO_BUNDLE = '3 PLAY - Internet + Telefonia + Television' THEN '3 PLAY - Internet + Telefonia + Television'
												      WHEN TIPO_BUNDLE = '3 PLAY Internet + Linea Fija + Ott'         THEN '3 PLAY - Internet + Telefonia + Television'
												      WHEN TIPO_BUNDLE = '3 PLAY Internet + Iptv + Linea Fija'        THEN '3 PLAY - Internet + Telefonia + Television'        ELSE TIPO_BUNDLE
											      END AS TIPO_PAQUETE,
											    CASE
											          WHEN ORIGEN = 'LEG' AND TIPO_SOT IN ('Desconexion de Servicio por Mora') THEN 'MORA'
											          WHEN ORIGEN = 'HWE' AND MODALIDAD = 'Desvincular Grupo FMC' THEN 'MORA'
											          WHEN ORIGEN = 'HWE' AND TIPO_MOTIVO_ATENCION in ('Deactivate by DC','Desactivacion por cobranzas','Desconexion de Servicio por Mora') THEN 'MORA'
											          WHEN TIPO_MOTIVO_ATENCION ='Deactivate by delay activation (DC)' THEN 'DIFERIDA' ELSE 'VOLUNTARIA'
											     END TIPO_BAJA,                   
											   	MOTIVO_SUSPENSION,
											    TELEFONOS,
											    DIRECCION, 
											    PARROQUIA,
											    MARCA,
											    MODELO,
											    CONTRATISTA,
											    TIPO_TRABAJO,
											    CANAL_FINAL,
											    COINCIDENCIA_ALTA_BAJA,
											    ORIGEN_VENTA, 
											    ID_CICLO,
											    REGION_F AS REGION
											FROM ( SELECT A.*,  
											             CASE 
														      WHEN A.CANTON='BOLIVAR' AND A.REGION_EJECUTIVO IN ('MONTE OLIVO','SAN VICENTE DE PUSIR','SAN RAFAEL','LOS ANDES') THEN 'R1'
											                  WHEN A.CANTON='BOLIVAR' AND A.REGION_EJECUTIVO IN ('MEMBRILLO','QUIROGA','CALCETA')THEN 'R2'
											                  WHEN A.CANTON IN ('QUITO','RUMINAHUI') THEN 'R1' ELSE B.REGION 
											              END REGION_F
											         FROM OID_DB.OID_DB.OID_MOVIMIENTOS_FIJO A 
											         LEFT JOIN ( SELECT PROVINCIA, CANTON, REGION 
														           FROM OID_DB.MAPEO.SAC_REGION_ALTA 
														          WHERE (DPA_CANTON||DPA_PARROQUIA)<>'1318131850' 
														            AND (DPA_PROVINCIA||DPA_CANTON) NOT IN ('040402','131302') GROUP BY 1,2,3) B        
											          ON A.CANTON=B.CANTON  )  A                  
											 WHERE TIPOTRANSACCION  IN ('BAJA_FIJO','CANC_FIJO','BAJA_MIG' )
											   AND FECHA_PROCESO>= DATE('20250901')     
										

											 )  B

								 LEFT JOIN (SELECT *
								              FROM (SELECT  SUBSCRIBER_ID,OFICINA_EJECUTIVO,CANAL_VENTA_EJECUTIVO,MARCA,MODELO,ANCHO_BANDA ANCHO_BANDA_INV,                  
								                            ROW_NUMBER() OVER(PARTITION BY A.SUBSCRIBER_ID ORDER BY A.FECHA_PROCESO DESC) NFILA
								                     FROM OID_DB.OID_DB.OID_INVENTARIO_FIJO A
								                    WHERE A.FECHA_PROCESO >= DATE('20250901')
								                      AND TIPO_SERVICIO = 'PRIMARIA'
								                    ORDER BY A.ID_PRODUCTO) X
								             WHERE X.NFILA = 1) C
											 
								  ON B.SUBSCRIBER_ID = C.SUBSCRIBER_ID	) A	 ) A  
								  
								  
			LEFT JOIN (SELECT *
			             FROM ( SELECT USUARIO, CAMPANIA AS CAMPANIA_SAC
			                      FROM ( SELECT USUARIO, CAMPANIA, 
			                                    ROW_NUMBER() OVER(PARTITION BY USUARIO ORDER BY CAMPANIA DESC) ORDEN
			                              FROM SANDBOX.SAC_FID.SAC_USUARIOS_CAMPANIAS ) A
			                     WHERE ORDEN=1 ) A) B 
								 
			  ON A.USUARIO_REGISTRO = B.USUARIO

			LEFT JOIN (SELECT *
			             FROM ( SELECT USUARIO, CAMPANIA AS CAMPANIA_SAC_2
			                      FROM ( SELECT USUARIO, CAMPANIA, 
			                                    ROW_NUMBER() OVER(PARTITION BY USUARIO ORDER BY CAMPANIA DESC) ORDEN
			                               FROM SANDBOX.SAC_FID.SAC_USUARIOS_CAMPANIAS ) A
			                      WHERE ORDEN=1 ) A ) C 
								  
			  ON A.USUARIO_ULTIMA_TRANSACCION = C.USUARIO 					  
    ) A
