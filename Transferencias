
WITH OFERTAS_UNICAS AS (
    SELECT
        SUBSCRIBER_ID,
        ID_DETALLE_PLAN,
        FECHA_ACTIVACION_SUP,

        MAX(
            CASE
                WHEN FECHA_PROCESO < DATE '2026-10-02'
                THEN 1 ELSE 0
            END
        ) AS CORTE_ORIGINAL,

        MAX(
            CASE
                WHEN FECHA_PROCESO >= DATE '2026-10-02'
                THEN 1 ELSE 0
            END
        ) AS CORTE_ADICIONAL

    FROM OID_DB.OID_DB.OID_INVENTARIO_FIJO

    WHERE TIPO_SERVICIO = 'SUPLEMENTARIA'
      AND FECHA_ACTIVACION_SUP >= DATE '2026-09-01'
      AND FECHA_ACTIVACION_SUP < DATE '2026-10-01'
      AND FECHA_PROCESO >= DATE '2026-09-01'
      AND FECHA_PROCESO < DATE '2026-10-12'
      AND SUBSCRIBER_ID IS NOT NULL
      AND ID_DETALLE_PLAN IS NOT NULL

    GROUP BY
        SUBSCRIBER_ID,
        ID_DETALLE_PLAN,
        FECHA_ACTIVACION_SUP
)

SELECT
    SUM(CORTE_ORIGINAL) AS OFERTAS_QUERY_ORIGINAL,

    SUM(
        CASE
            WHEN CORTE_ORIGINAL = 0
             AND CORTE_ADICIONAL = 1
            THEN 1 ELSE 0
        END
    ) AS OFERTAS_ADICIONALES,

    COUNT(*) AS TOTAL_OFERTAS_AMPLIADO,

    COUNT(DISTINCT SUBSCRIBER_ID)
        AS SERVICIOS_UNICOS

FROM OFERTAS_UNICAS;
