SELECT
SUBSCRIBER_ID,
FECHA_BAJA,
FAMILIA,
GRUPO_ORIGEN,
TIPO_BAJA,
SUBCLASIFICACION_INFORME_GERENCIAL,
ID_IDENTIFICACION,
    CASE
        WHEN ID_IDENTIFICACION IN ('CARNE DE REFUGIADO','CED','CEDULA','CR','PAS','PASAPORTE','RC') THEN 'MASIVO'
        ELSE ID_IDENTIFICACION
        END AS SEGMENTO
FROM SANDBOX.SAC_RET.FIJO_FINAL_ABONADOS_BAJAS_IG

WHERE GRUPO_ORIGEN = 'BAJAS'
    AND TIPO_BAJA = 'VOLUNTARIA'
    AND FECHA_PROCESO = '202610'
