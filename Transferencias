
WITH INTENCIONES_UNIFICADAS AS (

    SELECT
        'INSTANTCALL' AS CANAL,
        ID_SERVICIO,
        IDENTIFICACION,
        FECHA_CREACION,
        FECHA_IMPACTO,
        FAMILIA_FINAL,
        TECNOLOGIA_FINAL,
        CATEGORIA_RESOLUCION_NIVEL_2F
    FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_INSTANTCALL
    WHERE FECHA_IMPACTO >= DATE '2026-09-01'
      AND FECHA_IMPACTO < DATE '2026-10-01'
      AND CATEGORIA_RESOLUCION_NIVEL_2F <> 'RECHAZADO'

    UNION ALL

    SELECT
        'KIOSKO' AS CANAL,
        SUBSCRIBER_ID,
        IDENTIFICACION_CLIENTE,
        FECHA_INGRESO,
        FECHA_IMPACTO,
        SUBPRODUCTO_HOMOLOGADO_FINAL,
        TECNOLOGIA_FINAL1,
        TIPOLOGIA_GESTION
    FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_KIOSKO
    WHERE FECHA_IMPACTO >= DATE '2026-09-01'
      AND FECHA_IMPACTO < DATE '2026-10-01'
      AND NFILAF = 1

    UNION ALL

    SELECT
        'INBOUND' AS CANAL,
        ID_SERVICIO,
        IDENTIFICACION,
        FECHA_CREACION,
        FECHA_IMPACTO,
        FAMILIA_FINAL,
        TECNOLOGIA_FINAL,
        CATEGORIA_RESOLUCION_NIVEL_2_F
    FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_INBOUND
    WHERE FECHA_IMPACTO >= DATE '2026-09-01'
      AND FECHA_IMPACTO < DATE '2026-10-01'
      AND RNR = 1
      AND NFILAF = 1

    UNION ALL

    SELECT
        'BARRA' AS CANAL,
        SUBSCRIBER_FINAL,
        IDENTIFICACION,
        FECHA,
        TO_DATE(MES_IMPACTO, 'YYYYMM'),
        SUBPRODUCTO_HOMOLOGADO_FF,
        TECNOLOGIA_FINAL_F,
        NULL AS CATEGORIA_RESOLUCION_NIVEL_2F
    FROM SANDBOX.SAC_RET.FIJO_INTENCION_BARRA
    WHERE MES_IMPACTO = '202609'
      AND RNR = 1
      AND NFILAFF = 1
      AND TECNOLOGIA_FINAL_F IN ('HFC', 'GPON')
)

SELECT
    CANAL,
    COUNT(*) AS TOTAL_INTENCIONES
FROM INTENCIONES_UNIFICADAS
GROUP BY CANAL
ORDER BY CANAL;
