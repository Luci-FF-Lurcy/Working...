
/*######################################################################
  BAJAS OCTUBRE 2026 - ULTIMA INTENCION PREVIA
  OBJETIVO: UNA FILA POR CADA REGISTRO DE BAJA
######################################################################*/

WITH INTENCIONES_GLOBAL AS (

    SELECT
        'PRIMERA LINEA' AS LINEA,
        INTENCIONES.*

    FROM (

        /*-------------------- INBOUND --------------------*/

        SELECT
            'INBOUND' AS CANAL,
            CAST(FECHA_CREACION AS DATE) AS FECHA_INTENCION,
            ID_ORDEN_TRABAJO,
            ID_SERVICIO AS SUBSCRIBER_ID,
            CATEGORIZACION_OPERACIONAL_N1,
            CATEGORIZACION_OPERACIONAL_N3,
            UBICACIONES_ATENCION,
            CATEGORIA_RESOLUCION_NIVEL_2_F AS RESULTADO_GESTION,
            CATEGORIA_RESOLUCION_NIVEL_3 AS HERRAMIENTA_RETENCION,
            FECHA_IMPACTO,
            CASE
                WHEN UPPER(GRUPO_SOPORTE_ASIGNADOF)
                     IN ('RRSS','CONTACT CENTER')
                 AND UPPER(CATEGORIA_RESOLUCION_NIVEL_2_F)
                     NOT IN ('RECHAZADO') THEN 1

                WHEN UPPER(GRUPO_SOPORTE_ASIGNADOF)
                     IN ('RETENCIÓN Y RECUPERACIÓN')
                 AND UPPER(CATEGORIA_RESOLUCION_NIVEL_2_F)
                     IN ('NO RETENIDO','RETENIDO') THEN 1
            END AS RNR

        FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_INBOUND

        WHERE RNR = 1

        UNION ALL

        /*-------------------- KIOSKO --------------------*/

        SELECT
            'KIOSKO' AS CANAL,
            FECHA_INGRESO AS FECHA_INTENCION,
            ID_ORDEN_TRABAJO,
            SUBSCRIBER_ID,
            CATEGORIZACION_OPERACIONAL_N1,
            CATEGORIZACION_OPERACIONAL_N3,
            CAC AS UBICACIONES_ATENCION,
            TIPOLOGIA_GESTION AS RESULTADO_GESTION,
            CATEGORIA_RESOLUCION_NIVEL_3 AS HERRAMIENTA_RETENCION,
            FECHA_IMPACTO,
            NULL AS RNR

        FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_KIOSKO

        UNION ALL

        /*-------------------- INSTANTCALL --------------------*/

        SELECT
            'INSTANTCALL' AS CANAL,
            CAST(FECHA_CREACION AS DATE) AS FECHA_INTENCION,
            ID_ORDEN_TRABAJO,
            ID_SERVICIO AS SUBSCRIBER_ID,
            CATEGORIZACION_OPERACIONAL_N1,
            CATEGORIZACION_OPERACIONAL_N3,
            UBICACIONES_ATENCION,
            CATEGORIA_RESOLUCION_NIVEL_2F AS RESULTADO_GESTION,
            CATEGORIA_RESOLUCION_NIVEL_3 AS HERRAMIENTA_RETENCION,
            FECHA_IMPACTO,
            NULL AS RNR

        FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_INSTANTCALL

        WHERE CATEGORIA_RESOLUCION_NIVEL_2F <> 'RECHAZADO'

    ) AS INTENCIONES

    WHERE INTENCIONES.FECHA_INTENCION >= DATE '2026-09-01'
      AND INTENCIONES.FECHA_INTENCION < DATE '2026-10-01'
),

/*--------------------------------------------------------------------
  BASE DE BAJAS
  SE CONSERVAN LOS FILTROS ORIGINALES DEL INFORME GERENCIAL
--------------------------------------------------------------------*/

BAJAS_OCTUBRE AS (

    SELECT
        ROW_NUMBER() OVER (
            ORDER BY
                SUBSCRIBER_ID,
                FECHA_BAJA,
                FAMILIA,
                SUBCLASIFICACION_INFORME_GERENCIAL,
                ID_IDENTIFICACION
        ) AS ID_REGISTRO_BAJA,

        SUBSCRIBER_ID,
        FECHA_BAJA,
        FAMILIA,
        GRUPO_ORIGEN,
        TIPO_BAJA,
        SUBCLASIFICACION_INFORME_GERENCIAL,
        ID_IDENTIFICACION,

        CASE
            WHEN ID_IDENTIFICACION IN (
                'CARNE DE REFUGIADO',
                'CED',
                'CEDULA',
                'CR',
                'PAS',
                'PASAPORTE',
                'RC'
            ) THEN 'MASIVO'
            ELSE ID_IDENTIFICACION
        END AS SEGMENTO

    FROM SANDBOX.SAC_RET.FIJO_FINAL_ABONADOS_BAJAS_IG

    WHERE GRUPO_ORIGEN = 'BAJAS'
      AND TIPO_BAJA = 'VOLUNTARIA'
      AND FECHA_PROCESO = '202610'
),

/*--------------------------------------------------------------------
  LEFT JOIN Y ORDENAMIENTO DE INTENCIONES
--------------------------------------------------------------------*/

CRUCE AS (

    SELECT
        B.ID_REGISTRO_BAJA,
        B.SUBSCRIBER_ID,
        B.FECHA_BAJA,
        B.FAMILIA,
        B.GRUPO_ORIGEN,
        B.TIPO_BAJA,
        B.SUBCLASIFICACION_INFORME_GERENCIAL,
        B.ID_IDENTIFICACION,
        B.SEGMENTO,

        I.LINEA,
        I.CANAL,
        I.FECHA_INTENCION,
        I.ID_ORDEN_TRABAJO,
        I.CATEGORIZACION_OPERACIONAL_N1,
        I.CATEGORIZACION_OPERACIONAL_N3,
        I.UBICACIONES_ATENCION,
        I.RESULTADO_GESTION,
        I.HERRAMIENTA_RETENCION,
        I.FECHA_IMPACTO,
        I.RNR,

        /* TOTAL DE INTENCIONES PREVIAS POR REGISTRO DE BAJA */

        COUNT(I.SUBSCRIBER_ID) OVER (
            PARTITION BY B.ID_REGISTRO_BAJA
        ) AS TOTAL_INTENCIONES_PREVIAS,

        /* ORDENAR DE LA INTENCION MAS RECIENTE A LA MAS ANTIGUA */

        ROW_NUMBER() OVER (
            PARTITION BY B.ID_REGISTRO_BAJA
            ORDER BY
                I.FECHA_INTENCION DESC,
                I.ID_ORDEN_TRABAJO DESC
        ) AS RN

    FROM BAJAS_OCTUBRE B

    LEFT JOIN INTENCIONES_GLOBAL I
        ON B.SUBSCRIBER_ID = I.SUBSCRIBER_ID
       AND I.FECHA_INTENCION < B.FECHA_BAJA
),

/*--------------------------------------------------------------------
  CONSERVAR SOLAMENTE LA ULTIMA INTENCION DE CADA BAJA
--------------------------------------------------------------------*/

RESULTADO_FINAL AS (

    SELECT
        ID_REGISTRO_BAJA,
        SUBSCRIBER_ID,
        FECHA_BAJA,
        FAMILIA,
        GRUPO_ORIGEN,
        TIPO_BAJA,
        SUBCLASIFICACION_INFORME_GERENCIAL,
        ID_IDENTIFICACION,
        SEGMENTO,

        LINEA,
        CANAL,
        FECHA_INTENCION,
        ID_ORDEN_TRABAJO,
        CATEGORIZACION_OPERACIONAL_N1,
        CATEGORIZACION_OPERACIONAL_N3,
        UBICACIONES_ATENCION,
        RESULTADO_GESTION,
        HERRAMIENTA_RETENCION,
        FECHA_IMPACTO,
        RNR,

        TOTAL_INTENCIONES_PREVIAS,

        CASE
            WHEN TOTAL_INTENCIONES_PREVIAS > 0 THEN 1
            ELSE 0
        END AS TIENE_INTENCION

    FROM CRUCE

    WHERE RN = 1
)

/*--------------------------------------------------------------------
  RESULTADO Y RESUMEN DE COBERTURA
--------------------------------------------------------------------*/

SELECT
    R.*,

    COUNT(*) OVER () AS TOTAL_BAJAS,

    SUM(TIENE_INTENCION) OVER ()
        AS BAJAS_CON_INTENCION,

    SUM(
        CASE WHEN TIENE_INTENCION = 0 THEN 1 ELSE 0 END
    ) OVER () AS BAJAS_SIN_INTENCION

FROM RESULTADO_FINAL R
;
