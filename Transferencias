
WITH BAJAS_OCTUBRE AS (
    SELECT
        SUBSCRIBER_ID,
        FECHA_BAJA,
        DATE(FECHA_BAJA) AS FECHA_BAJA_DIA,
        FAMILIA AS FAMILIA_BAJA,
        SUBCLASIFICACION_INFORME_GERENCIAL AS MOTIVO_BAJA,
        FECHA_PROCESO AS CORTE_BAJA

    FROM SANDBOX.SAC_RET.FIJO_FINAL_ABONADOS_BAJAS_IG

    WHERE GRUPO_ORIGEN = 'BAJAS'
      AND TIPO_BAJA = 'VOLUNTARIA'
      AND ID_IDENTIFICACION IN (
          'CARNE DE REFUGIADO',
          'CED',
          'CEDULA',
          'CR',
          'PAS',
          'PASAPORTE',
          'RC'
      )
      AND FECHA_PROCESO = '202610'
      AND FECHA_BAJA >= DATE '2026-10-01'
      AND FECHA_BAJA < DATE '2026-11-01'
),

INTENCIONES AS (
    SELECT
        SUBSCRIBER_ID,
        FECHA_INTENCION,
        RESULTADO_INTENCION

    FROM (
        /* UNION ALL VALIDADO DE INBOUND,
           KIOSKO E INSTANTCALL */
    ) U

    WHERE FECHA_INTENCION >= DATE '2026-09-01'
      AND FECHA_INTENCION < DATE '2026-11-01'
)

SELECT
    B.SUBSCRIBER_ID,
    B.FECHA_BAJA_DIA,
    B.FAMILIA_BAJA,
    B.MOTIVO_BAJA,
    B.CORTE_BAJA,

    CASE
        WHEN EXISTS (
            SELECT 1
            FROM INTENCIONES I
            WHERE I.SUBSCRIBER_ID = B.SUBSCRIBER_ID
              AND I.FECHA_INTENCION < B.FECHA_BAJA
        )
        THEN 1
        ELSE 0
    END AS TIENE_INTENCION,

    CASE
        WHEN EXISTS (
            SELECT 1
            FROM INTENCIONES I
            WHERE I.SUBSCRIBER_ID = B.SUBSCRIBER_ID
              AND I.FECHA_INTENCION < B.FECHA_BAJA
              AND I.RESULTADO_INTENCION = 'RETENIDO'
        )
        THEN 1
        ELSE 0
    END AS TIENE_RETENCION_PREVIA

FROM BAJAS_OCTUBRE B
;
