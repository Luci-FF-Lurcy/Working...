
WITH BAJAS_OCTUBRE AS (
    SELECT
        SUBSCRIBER_ID,
        DATE(FECHA_BAJA) AS FECHA_BAJA

    FROM SANDBOX.SAC_RET.FIJO_FINAL_ABONADOS_BAJAS_IG

    WHERE GRUPO_ORIGEN = 'BAJAS'
      AND TIPO_BAJA = 'VOLUNTARIA'
      AND ID_IDENTIFICACION IN (
          'CARNE DE REFUGIADO',
          'CED',
          'CEDULA',
          'CR',
          'PAS',
          'PASAPORTE',
          'RC'
      )
      AND FECHA_PROCESO = '202610'
),

INTENCIONES AS (
    /* UNION ALL VALIDADO */
)

SELECT
    COUNT(*) AS TOTAL_BAJAS,

    SUM(
        CASE
            WHEN B.FECHA_BAJA IS NOT NULL
             AND EXISTS (
                SELECT 1
                FROM INTENCIONES I
                WHERE I.SUBSCRIBER_ID = B.SUBSCRIBER_ID
                  AND I.FECHA_INTENCION < B.FECHA_BAJA
             )
            THEN 1
            ELSE 0
        END
    ) AS BAJAS_CON_INTENCION,

    SUM(
        CASE
            WHEN B.FECHA_BAJA IS NOT NULL
             AND NOT EXISTS (
                SELECT 1
                FROM INTENCIONES I
                WHERE I.SUBSCRIBER_ID = B.SUBSCRIBER_ID
                  AND I.FECHA_INTENCION < B.FECHA_BAJA
             )
            THEN 1
            ELSE 0
        END
    ) AS BAJAS_SIN_INTENCION,

    SUM(
        CASE
            WHEN B.FECHA_BAJA IS NULL THEN 1
            ELSE 0
        END
    ) AS BAJAS_SIN_FECHA

FROM BAJAS_OCTUBRE B
;
