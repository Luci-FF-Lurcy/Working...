WITH BAJAS_OCTUBRE AS (
    SELECT
        SUBSCRIBER_ID,
        DATE(FECHA_BAJA) AS FECHA_BAJA,
        FAMILIA AS FAMILIA_BAJA,
        SUBCLASIFICACION_INFORME_GERENCIAL AS MOTIVO_BAJA,
        FECHA_PROCESO AS CORTE_BAJA

    FROM SANDBOX.SAC_RET.FIJO_FINAL_ABONADOS_BAJAS_IG

    WHERE GRUPO_ORIGEN = 'BAJAS'
      AND TIPO_BAJA = 'VOLUNTARIA'
      AND ID_IDENTIFICACION IN (
          'CARNE DE REFUGIADO',
          'CED',
          'CEDULA',
          'CR',
          'PAS',
          'PASAPORTE',
          'RC'
      )
      AND FECHA_PROCESO = '202610'
)

SELECT
    I.*,

    B.FECHA_BAJA,
    B.FAMILIA_BAJA,
    B.MOTIVO_BAJA,
    B.CORTE_BAJA,

    CASE
        WHEN B.SUBSCRIBER_ID IS NULL
            THEN 'SIN BAJA EN CORTE 202610'

        WHEN B.FECHA_BAJA IS NULL
            THEN 'BAJA SIN FECHA'

        WHEN B.FECHA_BAJA < I.FECHA_INTENCION
            THEN 'BAJA ANTERIOR A INTENCION'

        ELSE 'BAJA POSTERIOR O MISMO DIA'
    END AS RELACION_BAJA,

    CASE
        WHEN B.SUBSCRIBER_ID IS NOT NULL THEN 1
        ELSE 0
    END AS TIENE_BAJA

FROM (

SELECT --INTENCIONES.CANAL, COUNT(*)--
'PRIMERA LINEA' AS LINEA, INTENCIONES.* 
FROM(
    SELECT
    'INBOUND' AS CANAL,
    CAST (FECHA_CREACION AS DATE) AS FECHA_INTENCION,
    ID_ORDEN_TRABAJO,
    ID_SERVICIO AS SUBSCRIBER_ID,
    CATEGORIZACION_OPERACIONAL_N1,
    CATEGORIZACION_OPERACIONAL_N3,
    UBICACIONES_ATENCION,
    CATEGORIA_RESOLUCION_NIVEL_2_F AS RESULTADO_GESTION,
    CATEGORIA_RESOLUCION_NIVEL_3 AS HERRAMIENTA_RETENCION,
    FECHA_IMPACTO,
    CASE 
        WHEN UPPER(GRUPO_SOPORTE_ASIGNADOF) IN ('RRSS','CONTACT CENTER') AND UPPER(CATEGORIA_RESOLUCION_NIVEL_2_F) NOT IN ('RECHAZADO') THEN 1
        WHEN UPPER(GRUPO_SOPORTE_ASIGNADOF) IN ('RETENCIÓN Y RECUPERACIÓN') AND UPPER(CATEGORIA_RESOLUCION_NIVEL_2_F) IN ('NO RETENIDO', 'RETENIDO') THEN 1 -- EMILIO
        END AS RNR
    FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_INBOUND
    WHERE RNR = 1

    UNION ALL 
    SELECT 
    'KIOSKO' AS CANAL,
    FECHA_INGRESO AS FECHA_INTENCION,
    ID_ORDEN_TRABAJO,
    SUBSCRIBER_ID,
    CATEGORIZACION_OPERACIONAL_N1,
    CATEGORIZACION_OPERACIONAL_N3,
    CAC AS UBICACIONES_ATENCION,
    TIPOLOGIA_GESTION AS RESULTADO_GESTION,
    CATEGORIA_RESOLUCION_NIVEL_3 AS HERRAMIENTA_RETENCION,
    FECHA_IMPACTO,
    NULL AS RNR
    FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_KIOSKO

    UNION ALL
    SELECT
    'INSTANTCALL' AS CANAL,
    CAST (FECHA_CREACION AS DATE) AS FECHA_INTENCION,
    ID_ORDEN_TRABAJO,
    ID_SERVICIO AS SUBSCRIBER_ID,
    CATEGORIZACION_OPERACIONAL_N1,
    CATEGORIZACION_OPERACIONAL_N3,
    UBICACIONES_ATENCION,
    CATEGORIA_RESOLUCION_NIVEL_2F AS RESULTADO_GESTION,
    CATEGORIA_RESOLUCION_NIVEL_3 AS HERRAMIENTA_RETENCION,
    FECHA_IMPACTO,
    NULL AS RNR
    FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_INSTANTCALL
    WHERE CATEGORIA_RESOLUCION_NIVEL_2F <> 'RECHAZADO' -- Preguntar EMILIO
) AS INTENCIONES

WHERE INTENCIONES.FECHA_INTENCION >= '2026-07-01'
AND INTENCIONES.FECHA_INTENCION < '2026-11-01'

) I

LEFT JOIN BAJAS_OCTUBRE B
    ON I.SUBSCRIBER_ID = B.SUBSCRIBER_ID
;
