WITH BAJAS_BASE AS
(
    SELECT
        A.SUBSCRIBER_ID,
        A.IDENTIFICACION,
        A.ID_IDENTIFICACION,
        A.ID_IDENTIFICACION_GRUPO,

        DATE(A.FECHA_BAJA) AS FECHA_BAJA,
        DATE(A.FECHA_ALTA) AS FECHA_ALTA,
        A.FECHA_PROCESO,

        TO_DATE(
            SUBSTR(CAST(A.FECHA_PROCESO AS VARCHAR(8)),1,6) || '01',
            'YYYYMMDD'
        ) AS FECHA_MES,

        A.FAMILIA,
        A.TECNOLOGIA,
        A.TIPO_BAJA,

        A.INFORME_GERENCIAL,
        A.SUBCLASIFICACION_INFORME_GERENCIAL,
        A.SUBCLASIFICACION_TIPO_BAJA,
        A.CLASIFICAR_TIPO_BAJA,
        A.TIPOLOGIA,
        A.USUARIO_FINAL,

        A.TIEMPO_VIDA,
        A.DESCRIPCION_FORMA_PAGO,

        A.SEGMENTO_CLIENTE,
        A.CANAL_FINAL,
        A.CANAL_F,
        A.CANAL_VENTA_EJECUTIVO,

        A.PROVINCIA,
        A.NODO_FINAL,

        A.TOTAL_SERVICIOS,
        A.TIPO_PAQUETE,
        A.TARIFA_BASICA,
        A.VALOR_RECURRENTE,

        A.TIP_MOTIVO_ATENCION,
        A.TIPO_MOTIVO_ATENCION,
        A.GRUPO_ORIGEN,
        A.ORIGEN,

        A.BASE,
        A.ABONADOS_REALES,
        A.COINCIDENCIA_ALTA_BAJA,

        A.CATEGORIZACION_TIER_2,
        A.CATEGORIZACION_TIER_3,
        A.PRODUCTO,
        A.codigo_sucursal,
        A.tipo_transaccion,
        A.OFFERING_INST_ID

    FROM SANDBOX.SAC_RET.FIJO_FINAL_ABONADOS_BAJAS_IG A

    WHERE A.FECHA_PROCESO >= '20260801'
      AND A.FECHA_PROCESO <  '20261101'

      AND A.FAMILIA = 'Internet'
      AND A.INFORME_GERENCIAL IS NOT NULL

      AND A.TECNOLOGIA IN ('DTH','GPON','HFC')

      AND UPPER(TRIM(A.ID_IDENTIFICACION_GRUPO)) = 'MASIVO'

      AND UPPER(TRIM(A.DESCRIPCION_FORMA_PAGO))
          IN ('BANCO EN TRAMITE','BANCO','CFA')
),

GPON_MAP AS
(
    SELECT
        CASE
            WHEN REGION = 'R1' THEN 'REGION 1'
            WHEN REGION = 'R2' THEN 'REGION 2'
        END AS REGION_L,

        OLT,
        CLUSTE,
        CIUDAD,
        DISPONIBILIDAD_HP_TOTAL,

        ROW_NUMBER() OVER (
            PARTITION BY CLUSTE
            ORDER BY FECHA_PROCESO DESC
        ) AS RN

    FROM OID_DB.MAPEO.TIC_HPS_LIBERADAS_GPON

    WHERE FECHA_PROCESO =
    (
        SELECT MAX(FECHA_PROCESO)
        FROM OID_DB.MAPEO.TIC_HPS_LIBERADAS_GPON
    )
),

HFC_MAP AS
(
    SELECT
        REGION_HUB AS REGION,
        PARROQUIA_HUB,
        NODO,
        GF_BF,
        CIUDAD_HUB,
        DISPONIBILIDAD_HP_TOTAL,

        ROW_NUMBER() OVER (
            PARTITION BY NODO
            ORDER BY FECHA_PROCESO DESC
        ) AS RN

    FROM OID_DB.MAPEO.TIC_HPS_LIBERADAS_HFC

    WHERE FECHA_PROCESO =
    (
        SELECT MAX(FECHA_PROCESO)
        FROM OID_DB.MAPEO.TIC_HPS_LIBERADAS_HFC
    )
),

NSE_MAP AS
(
    SELECT
        CASE
            WHEN ID_NSE = '1' THEN 'Muy Alto'
            WHEN ID_NSE = '2' THEN 'Alto'
            WHEN ID_NSE = '3' THEN 'Medio Tipico'
            WHEN ID_NSE = '4' THEN 'Medio Bajo'
            WHEN ID_NSE = '5' THEN 'Bajo'
            ELSE CAST(ID_NSE AS VARCHAR(20))
        END AS CATEGORIA_NSE,

        ID_RED

    FROM OID_DB.OID_DB.OID_RESUMEN_RED_FIJA

    WHERE FECHA_PROCESO =
    (
        SELECT MAX(FECHA_PROCESO)
        FROM OID_DB.OID_DB.OID_RESUMEN_RED_FIJA
    )
),

BAJAS_ENRIQUECIDAS AS
(
    SELECT
        B.*,

        CASE
            WHEN B.TECNOLOGIA = 'GPON' THEN C.REGION_L
            WHEN B.TECNOLOGIA = 'HFC' THEN D.REGION
        END AS REGION_LIBERADO,

        CASE
            WHEN B.TECNOLOGIA = 'GPON' THEN C.OLT
            WHEN B.TECNOLOGIA = 'HFC' THEN D.PARROQUIA_HUB
        END AS OLT_LIBERADO,

        CASE
            WHEN B.TECNOLOGIA = 'GPON' THEN C.CLUSTE
            WHEN B.TECNOLOGIA = 'HFC' THEN D.NODO
        END AS CLUSTE_LIBERADO,

        CASE
            WHEN B.TECNOLOGIA = 'GPON' THEN UPPER(C.CIUDAD)
            WHEN B.TECNOLOGIA = 'HFC' THEN UPPER(D.CIUDAD_HUB)
        END AS CIUDAD_LIBERADO,

        CASE
            WHEN B.TECNOLOGIA = 'GPON'
                THEN C.DISPONIBILIDAD_HP_TOTAL
            WHEN B.TECNOLOGIA = 'HFC'
                THEN D.DISPONIBILIDAD_HP_TOTAL
        END AS TOTAL_HP,

        CAST(
            CASE
                WHEN B.TECNOLOGIA = 'GPON'
                    THEN C.DISPONIBILIDAD_HP_TOTAL
                WHEN B.TECNOLOGIA = 'HFC'
                    THEN D.DISPONIBILIDAD_HP_TOTAL
            END AS INT
        ) AS HOME_PASS_F,

        D.GF_BF,

        NS.CATEGORIA_NSE

    FROM BAJAS_BASE B

    LEFT JOIN GPON_MAP C
        ON (
            B.NODO_FINAL = C.CLUSTE
            OR SUBSTR(B.NODO_FINAL,1,6) = C.CLUSTE
            OR SUBSTR(B.NODO_FINAL,4,6) = C.CLUSTE
            OR SUBSTR(B.NODO_FINAL,1,5) = C.CLUSTE
        )
        AND C.RN = 1

    LEFT JOIN HFC_MAP D
        ON (
            B.NODO_FINAL = D.NODO
            OR SUBSTR(B.NODO_FINAL,1,6) = D.NODO
            OR SUBSTR(B.NODO_FINAL,4,6) = D.NODO
            OR SUBSTR(B.NODO_FINAL,1,5) = D.NODO
        )
        AND D.RN = 1

    LEFT JOIN NSE_MAP NS
        ON B.NODO_FINAL = NS.ID_RED
),

BAJAS_CLASIFICADAS AS
(
    SELECT
        E.*,

        CASE
            WHEN UPPER(TRIM(E.REGION_LIBERADO))
                 IN ('R1','REGION 1') THEN 'R1'
            WHEN UPPER(TRIM(E.REGION_LIBERADO))
                 IN ('R2','REGION 2') THEN 'R2'
            ELSE 'SIN ESPECIFICAR'
        END AS REGION_LIBERADO_GRUPO,

        CASE
            WHEN E.CATEGORIA_NSE = 'Muy Alto' THEN 'A'
            WHEN E.CATEGORIA_NSE = 'Alto' THEN 'B'
            WHEN E.CATEGORIA_NSE = 'Medio Tipico' THEN 'C+'
            WHEN E.CATEGORIA_NSE = 'Medio Bajo' THEN 'C-'
            WHEN E.CATEGORIA_NSE = 'Bajo' THEN 'D'
        END AS CATEGORIA_NSE_GRUPO,

        CASE
            WHEN E.INFORME_GERENCIAL = 'Fallas con el servicio'
                THEN 'Novedades con el servicio'
            WHEN E.INFORME_GERENCIAL = 'Asociado a altas'
                THEN 'Otras Bajas'
            WHEN E.INFORME_GERENCIAL = 'Renuncia Forzosa'
                THEN 'Baja en linea'
            ELSE E.INFORME_GERENCIAL
        END AS INFORME_GERENCIAL2,

        CASE
            WHEN E.TIEMPO_VIDA >= 0 AND E.TIEMPO_VIDA <= 3.99
                THEN '0-3'
            WHEN E.TIEMPO_VIDA >= 4 AND E.TIEMPO_VIDA <= 6.99
                THEN '4-6'
            WHEN E.TIEMPO_VIDA >= 7 AND E.TIEMPO_VIDA <= 12.99
                THEN '7-12'
            WHEN E.TIEMPO_VIDA >= 13 AND E.TIEMPO_VIDA <= 18.99
                THEN '13-18'
            WHEN E.TIEMPO_VIDA >= 19 AND E.TIEMPO_VIDA <= 24.99
                THEN '19-24'
            WHEN E.TIEMPO_VIDA >= 25 AND E.TIEMPO_VIDA <= 36
                THEN '25-36'
            WHEN E.TIEMPO_VIDA >= 36.01 AND E.TIEMPO_VIDA <= 48.99
                THEN '37-48'
            WHEN E.TIEMPO_VIDA >= 49 AND E.TIEMPO_VIDA <= 60.99
                THEN '49-60'
            ELSE '>60'
        END AS TIEMPO_VIDA_GRUPO

    FROM BAJAS_ENRIQUECIDAS E
)

SELECT *
FROM BAJAS_CLASIFICADAS

WHERE REGION_LIBERADO_GRUPO
      IN ('R1','R2','SIN ESPECIFICAR')

  AND CATEGORIA_NSE_GRUPO
      IN ('A','B','C+','C-','D');
