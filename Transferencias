
WITH BAJAS_OCTUBRE AS (
    SELECT
        SUBSCRIBER_ID,
        DATE(FECHA_BAJA) AS FECHA_BAJA,
        FAMILIA AS FAMILIA_BAJA,
        SUBCLASIFICACION_INFORME_GERENCIAL AS MOTIVO_BAJA,
        FECHA_PROCESO AS CORTE_BAJA

    FROM SANDBOX.SAC_RET.FIJO_FINAL_ABONADOS_BAJAS_IG

    WHERE GRUPO_ORIGEN = 'BAJAS'
      AND TIPO_BAJA = 'VOLUNTARIA'
      AND ID_IDENTIFICACION IN (
          'CARNE DE REFUGIADO',
          'CED',
          'CEDULA',
          'CR',
          'PAS',
          'PASAPORTE',
          'RC'
      )
      AND FECHA_PROCESO = '202610'
)

SELECT
    I.*,

    B.FECHA_BAJA,
    B.FAMILIA_BAJA,
    B.MOTIVO_BAJA,
    B.CORTE_BAJA,

    CASE
        WHEN B.SUBSCRIBER_ID IS NULL
            THEN 'SIN BAJA EN CORTE 202610'

        WHEN B.FECHA_BAJA IS NULL
            THEN 'BAJA SIN FECHA'

        WHEN B.FECHA_BAJA < I.FECHA_INTENCION
            THEN 'BAJA ANTERIOR A INTENCION'

        ELSE 'BAJA POSTERIOR O MISMO DIA'
    END AS RELACION_BAJA,

    CASE
        WHEN B.SUBSCRIBER_ID IS NOT NULL THEN 1
        ELSE 0
    END AS TIENE_BAJA

FROM (
    /* AQUÍ VA TU CONSULTA UNION ALL VALIDADA,
       SIN EL LIMIT Y SIN EL PUNTO Y COMA FINAL */
) I

LEFT JOIN BAJAS_OCTUBRE B
    ON I.SUBSCRIBER_ID = B.SUBSCRIBER_ID
;
