---
Crea un query para relacionar las tablas OID_INVENTARIO_OFERTAS_FIJO con la de INVENTARIO de forma que pueda comparar cuales ofertas activadas no estoy considerando

Toma en cuenta estos apuntes de la primera tabla: 
OID_INVENTARIO_OFERTAS_FIJO: Tabla que lleva el registro de todas las ofertas suplementarias activadas:
  - OFFERING_ID = ID_DETALLE_PLAN: Código de DETALLE_PLAN
  - FECHA_ACTIVACION = FECHA_ACTIVACION_SUP
  - FECHA_INACTIVACION = FECHA_VENCIMIENTO_SUP
  - OFFERING_NAME = DETALLE_PLAN
  - ID_SERVICIO = SUBSCRIBER_ID
  - EMPLOYEE_CODE Código del empleado que aplicó el Descuento
  - EMPLOYEE_NAME: Nombre del empleado que aplicó 
WITH OFERTAS_BASE AS (
    SELECT
        O.ID_SERVICIO,
        O.OFFERING_ID,
        DATE(O.FECHA_ACTIVACION) AS FECHA_ACTIVACION,
        O.FECHA_INACTIVACION,
        O.OFFERING_NAME,
        O.EMPLOYEE_CODE,
        O.EMPLOYEE_NAME,

        ROW_NUMBER() OVER (
            PARTITION BY
                O.ID_SERVICIO,
                O.OFFERING_ID,
                DATE(O.FECHA_ACTIVACION)
            ORDER BY
                O.FECHA_INACTIVACION DESC,
                O.EMPLOYEE_CODE DESC
        ) AS RN

    FROM OID_DB.OID_DB.OID_INVENTARIO_OFERTAS_FIJO O

    WHERE O.FECHA_ACTIVACION >= DATE '2026-09-01'
      AND O.FECHA_ACTIVACION < DATE '2026-10-01'
),

OFERTAS_UNICAS AS (
    SELECT
        ID_SERVICIO,
        OFFERING_ID,
        FECHA_ACTIVACION,
        FECHA_INACTIVACION,
        OFFERING_NAME,
        EMPLOYEE_CODE,
        EMPLOYEE_NAME
    FROM OFERTAS_BASE
    WHERE RN = 1
),

SERVICIOS_OBJETIVO AS (
    SELECT DISTINCT ID_SERVICIO
    FROM OFERTAS_UNICAS
    WHERE ID_SERVICIO IS NOT NULL
),

INVENTARIO_BASE AS (
    SELECT
        I.SUBSCRIBER_ID,
        I.ID_DETALLE_PLAN,
        DATE(I.FECHA_ACTIVACION_SUP)
            AS FECHA_ACTIVACION_SUP,

        MAX(I.FECHA_PROCESO)
            AS ULTIMA_FOTO,

        MAX(I.FECHA_VENCIMIENTO_SUP)
            AS FECHA_VENCIMIENTO_SUP,

        MAX(I.DETALLE_PLAN)
            AS DETALLE_PLAN,

        MAX(
            CASE
                WHEN I.FECHA_PROCESO < DATE '2026-10-02'
                THEN 1
                ELSE 0
            END
        ) AS EN_CORTE_ORIGINAL

    FROM OID_DB.OID_DB.OID_INVENTARIO_FIJO I

    INNER JOIN SERVICIOS_OBJETIVO S
        ON I.SUBSCRIBER_ID = S.ID_SERVICIO

    WHERE I.TIPO_SERVICIO = 'SUPLEMENTARIA'

      AND I.FECHA_ACTIVACION_SUP >= DATE '2026-09-01'
      AND I.FECHA_ACTIVACION_SUP < DATE '2026-10-01'

      AND I.FECHA_PROCESO >= DATE '2026-09-01'
      AND I.FECHA_PROCESO < DATE '2026-10-12'

    GROUP BY
        I.SUBSCRIBER_ID,
        I.ID_DETALLE_PLAN,
        DATE(I.FECHA_ACTIVACION_SUP)
)

SELECT
    O.ID_SERVICIO,
    O.OFFERING_ID,
    O.OFFERING_NAME,
    O.FECHA_ACTIVACION,
    O.FECHA_INACTIVACION,

    O.EMPLOYEE_CODE,
    O.EMPLOYEE_NAME,

    I.SUBSCRIBER_ID,
    I.ID_DETALLE_PLAN,
    I.DETALLE_PLAN,
    I.FECHA_ACTIVACION_SUP,
    I.FECHA_VENCIMIENTO_SUP,
    I.ULTIMA_FOTO,

    CASE
        WHEN O.ID_SERVICIO IS NULL
          OR O.OFFERING_ID IS NULL
          OR O.FECHA_ACTIVACION IS NULL
        THEN 'CLAVE_INCOMPLETA'

        WHEN I.SUBSCRIBER_ID IS NULL
        THEN 'NO_ENCONTRADA_EN_INVENTARIO'

        WHEN I.EN_CORTE_ORIGINAL = 0
        THEN 'APARECE_EN_FOTO_POSTERIOR'

        ELSE 'ENCONTRADA_EN_CORTE_ORIGINAL'
    END AS ESTADO_CRUCE

FROM OFERTAS_UNICAS O

LEFT JOIN INVENTARIO_BASE I
    ON O.ID_SERVICIO = I.SUBSCRIBER_ID
   AND O.OFFERING_ID = I.ID_DETALLE_PLAN
   AND O.FECHA_ACTIVACION = I.FECHA_ACTIVACION_SUP

ORDER BY
    ESTADO_CRUCE,
    O.FECHA_ACTIVACION,
    O.ID_SERVICIO;







