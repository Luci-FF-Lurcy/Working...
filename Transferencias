
/*######################################################################
   VALIDACION DE INTENCIONES PREVIAS A BAJAS DE OCTUBRE 2026
######################################################################*/

WITH INTENCIONES AS (

    SELECT
        'PRIMERA LINEA' AS LINEA,
        U.*

    FROM (

        /*-------------------- INBOUND --------------------*/

        SELECT
            'INBOUND' AS CANAL,
            CAST(FECHA_CREACION AS DATE) AS FECHA_INTENCION,
            ID_ORDEN_TRABAJO,
            ID_SERVICIO AS SUBSCRIBER_ID,
            CATEGORIZACION_OPERACIONAL_N1,
            CATEGORIZACION_OPERACIONAL_N3,
            UBICACIONES_ATENCION,
            CATEGORIA_RESOLUCION_NIVEL_2_F AS RESULTADO_GESTION,
            CATEGORIA_RESOLUCION_NIVEL_3 AS HERRAMIENTA_RETENCION,
            FECHA_IMPACTO,

            CASE
                WHEN UPPER(GRUPO_SOPORTE_ASIGNADOF)
                     IN ('RRSS','CONTACT CENTER')
                 AND UPPER(CATEGORIA_RESOLUCION_NIVEL_2_F)
                     NOT IN ('RECHAZADO')
                    THEN 1

                WHEN UPPER(GRUPO_SOPORTE_ASIGNADOF)
                     IN ('RETENCIÓN Y RECUPERACIÓN')
                 AND UPPER(CATEGORIA_RESOLUCION_NIVEL_2_F)
                     IN ('NO RETENIDO', 'RETENIDO')
                    THEN 1
            END AS RNR

        FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_INBOUND

        WHERE RNR = 1


        UNION ALL

        /*-------------------- KIOSKO --------------------*/

        SELECT
            'KIOSKO' AS CANAL,
            CAST(FECHA_INGRESO AS DATE) AS FECHA_INTENCION,
            ID_ORDEN_TRABAJO,
            SUBSCRIBER_ID,
            CATEGORIZACION_OPERACIONAL_N1,
            CATEGORIZACION_OPERACIONAL_N3,
            CAC AS UBICACIONES_ATENCION,
            TIPOLOGIA_GESTION AS RESULTADO_GESTION,
            CATEGORIA_RESOLUCION_NIVEL_3 AS HERRAMIENTA_RETENCION,
            FECHA_IMPACTO,
            NULL AS RNR

        FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_KIOSKO


        UNION ALL

        /*-------------------- INSTANTCALL --------------------*/

        SELECT
            'INSTANTCALL' AS CANAL,
            CAST(FECHA_CREACION AS DATE) AS FECHA_INTENCION,
            ID_ORDEN_TRABAJO,
            ID_SERVICIO AS SUBSCRIBER_ID,
            CATEGORIZACION_OPERACIONAL_N1,
            CATEGORIZACION_OPERACIONAL_N3,
            UBICACIONES_ATENCION,
            CATEGORIA_RESOLUCION_NIVEL_2F AS RESULTADO_GESTION,
            CATEGORIA_RESOLUCION_NIVEL_3 AS HERRAMIENTA_RETENCION,
            FECHA_IMPACTO,
            NULL AS RNR

        FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_INSTANTCALL

        WHERE CATEGORIA_RESOLUCION_NIVEL_2F <> 'RECHAZADO'

    ) U

    /* INTENCIONES REGISTRADAS EN SEPTIEMBRE */

    WHERE U.FECHA_INTENCION >= DATE '2026-09-01'
      AND U.FECHA_INTENCION < DATE '2026-10-01'
),

/*--------------------------------------------------------------------
  BAJAS VOLUNTARIAS DE OCTUBRE
--------------------------------------------------------------------*/

BAJAS_OCTUBRE AS (

    SELECT
        SUBSCRIBER_ID,
        DATE(FECHA_BAJA) AS FECHA_BAJA,
        FAMILIA AS FAMILIA_BAJA,
        SUBCLASIFICACION_INFORME_GERENCIAL AS MOTIVO_BAJA,
        FECHA_PROCESO AS CORTE_BAJA

    FROM SANDBOX.SAC_RET.FIJO_FINAL_ABONADOS_BAJAS_IG

    WHERE GRUPO_ORIGEN = 'BAJAS'
      AND TIPO_BAJA = 'VOLUNTARIA'

      AND ID_IDENTIFICACION IN (
          'CARNE DE REFUGIADO',
          'CED',
          'CEDULA',
          'CR',
          'PAS',
          'PASAPORTE',
          'RC'
      )

      AND FECHA_PROCESO = '202610'

      /* FECHA EFECTIVA DE BAJA EN OCTUBRE */

      AND FECHA_BAJA >= DATE '2026-10-01'
      AND FECHA_BAJA < DATE '2026-11-01'
)

/*--------------------------------------------------------------------
  CRUCE Y VALIDACION
--------------------------------------------------------------------*/

SELECT
    B.SUBSCRIBER_ID,
    B.FECHA_BAJA,
    B.FAMILIA_BAJA,
    B.MOTIVO_BAJA,
    B.CORTE_BAJA,

    /* EXISTENCIA DE AL MENOS UNA INTENCION PREVIA */

    CASE
        WHEN B.FECHA_BAJA IS NULL THEN NULL

        WHEN EXISTS (
            SELECT 1
            FROM INTENCIONES I

            WHERE I.SUBSCRIBER_ID = B.SUBSCRIBER_ID
              AND I.FECHA_INTENCION < B.FECHA_BAJA
        )
        THEN 1

        ELSE 0
    END AS TIENE_INTENCION,

    /* EXISTENCIA DE AL MENOS UNA INTENCION RETENIDA */

    CASE
        WHEN B.FECHA_BAJA IS NULL THEN NULL

        WHEN EXISTS (
            SELECT 1
            FROM INTENCIONES I

            WHERE I.SUBSCRIBER_ID = B.SUBSCRIBER_ID
              AND I.FECHA_INTENCION < B.FECHA_BAJA
              AND UPPER(TRIM(I.RESULTADO_GESTION)) = 'RETENIDO'
        )
        THEN 1

        ELSE 0
    END AS TIENE_RETENCION_PREVIA

FROM BAJAS_OCTUBRE B
;
