SELECT
    COUNT(*) AS TOTAL_INTENCIONES,

    COUNT(DISTINCT SUBSCRIBER_ID)
        AS SERVICIOS_UNICOS,

    COUNT(DISTINCT ID_ORDEN_TRABAJO)
        AS ORDENES_UNICAS,

    SUM(CASE
        WHEN SUBSCRIBER_ID IS NULL THEN 1
        ELSE 0
    END) AS SIN_SUBSCRIBER_ID,

    SUM(CASE
        WHEN ID_ORDEN_TRABAJO IS NULL THEN 1
        ELSE 0
    END) AS SIN_ID_ORDEN

FROM
(
    SELECT
        'INBOUND' AS CANAL,
        CAST(FECHA_CREACION AS DATE) AS FECHA_INTENCION,
        ID_ORDEN_TRABAJO,
        ID_SERVICIO AS SUBSCRIBER_ID
    FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_INBOUND
    WHERE
        CASE
            WHEN UPPER(GRUPO_SOPORTE_ASIGNADOF)
                IN ('RRSS','CONTACT CENTER')
                AND UPPER(CATEGORIA_RESOLUCION_NIVEL_2_F)
                NOT IN ('RECHAZADO') THEN 1

            WHEN UPPER(GRUPO_SOPORTE_ASIGNADOF)
                IN ('RETENCIÓN Y RECUPERACIÓN')
                AND UPPER(CATEGORIA_RESOLUCION_NIVEL_2_F)
                IN ('NO RETENIDO','RETENIDO') THEN 1
        END = 1

    UNION ALL

    SELECT
        'KIOSKO',
        FECHA_INGRESO,
        ID_ORDEN_TRABAJO,
        SUBSCRIBER_ID
    FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_KIOSKO

    UNION ALL

    SELECT
        'INSTANTCALL',
        CAST(FECHA_CREACION AS DATE),
        ID_ORDEN_TRABAJO,
        ID_SERVICIO
    FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_INSTANTCALL
    WHERE CATEGORIA_RESOLUCION_NIVEL_2F <> 'RECHAZADO'

) INTENCIONES

WHERE FECHA_INTENCION >= DATE '2026-10-01'
  AND FECHA_INTENCION < DATE '2026-11-01';
