WITH INTENCIONES AS (
    -- INBOUND
    SELECT
        'INBOUND' AS CANAL,
        CAST(FECHA_CREACION AS DATE) AS FECHA_INTENCION,
        ID_ORDEN_TRABAJO,
        ID_SERVICIO AS SUBSCRIBER_ID,
        CATEGORIZACION_OPERACIONAL_N1,
        CATEGORIZACION_OPERACIONAL_N3,
        UBICACIONES_ATENCION,
        CATEGORIA_RESOLUCION_NIVEL_2_F AS RESULTADO_GESTION,
        CATEGORIA_RESOLUCION_NIVEL_3 AS HERRAMIENTA_RETENCION,
        FECHA_IMPACTO,
        1 AS RNR
    FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_INBOUND
    WHERE FECHA_CREACION >= DATE '2026-01-01'
      AND FECHA_CREACION < DATE '2026-11-01'
      AND (
          (
              UPPER(GRUPO_SOPORTE_ASIGNADOF)
                  IN ('RRSS', 'CONTACT CENTER')
              AND UPPER(CATEGORIA_RESOLUCION_NIVEL_2_F)
                  NOT IN ('RECHAZADO')
          )
          OR
          (
              UPPER(GRUPO_SOPORTE_ASIGNADOF)
                  IN ('RETENCIÓN Y RECUPERACIÓN')
              AND UPPER(CATEGORIA_RESOLUCION_NIVEL_2_F)
                  IN ('NO RETENIDO', 'RETENIDO')
          )
      )

    UNION ALL

    -- KIOSKO
    SELECT
        'KIOSKO' AS CANAL,
        CAST(FECHA_INGRESO AS DATE) AS FECHA_INTENCION,
        ID_ORDEN_TRABAJO,
        SUBSCRIBER_ID,
        CATEGORIZACION_OPERACIONAL_N1,
        CATEGORIZACION_OPERACIONAL_N3,
        CAC AS UBICACIONES_ATENCION,
        TIPOLOGIA_GESTION AS RESULTADO_GESTION,
        CATEGORIA_RESOLUCION_NIVEL_3 AS HERRAMIENTA_RETENCION,
        FECHA_IMPACTO,
        NULL AS RNR
    FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_KIOSKO
    WHERE FECHA_INGRESO >= DATE '2026-01-01'
      AND FECHA_INGRESO < DATE '2026-11-01'

    UNION ALL

    -- INSTANTCALL
    SELECT
        'INSTANTCALL' AS CANAL,
        CAST(FECHA_CREACION AS DATE) AS FECHA_INTENCION,
        ID_ORDEN_TRABAJO,
        ID_SERVICIO AS SUBSCRIBER_ID,
        CATEGORIZACION_OPERACIONAL_N1,
        CATEGORIZACION_OPERACIONAL_N3,
        UBICACIONES_ATENCION,
        CATEGORIA_RESOLUCION_NIVEL_2F AS RESULTADO_GESTION,
        CATEGORIA_RESOLUCION_NIVEL_3 AS HERRAMIENTA_RETENCION,
        FECHA_IMPACTO,
        NULL AS RNR
    FROM SANDBOX.SAC_RET.FIJO_INTENCIONES_INSTANTCALL
    WHERE FECHA_CREACION >= DATE '2026-01-01'
      AND FECHA_CREACION < DATE '2026-11-01'
      AND CATEGORIA_RESOLUCION_NIVEL_2F <> 'RECHAZADO'
),

-- COMBINACIONES UNICAS DE SERVICIO Y FECHA
CLAVES_INTENCION AS (
    SELECT DISTINCT
        SUBSCRIBER_ID,
        FECHA_INTENCION
    FROM INTENCIONES
    WHERE SUBSCRIBER_ID IS NOT NULL
),

-- INVENTARIO LIMITADO A LAS INTENCIONES
INVENTARIO AS (
    SELECT
        INV.SUBSCRIBER_ID,
        INV.FECHA_PROCESO,
        INV.FECHA_ALTA,
        INV.SUBPRODUCTO_HOMOLOGADO,
        INV.ID_DETALLE_PLAN,
        INV.ID_FORMA_PAGO,
        INV.PARROQUIA,
        INV.PROVINCIA,
        INV.CANTON,
        INV.DESCRIPCION_PLAN,
        INV.TECNOLOGIA_HOMOLOGADA,
        INV.ID_IDENTIFICACION,
        INV.FECHA_NACIMIENTO,
        INV.SEGMENTO,
        INV.SEGMENTO_CLIENTE,
        INV.COMPARTICION,
        INV.CODIGO_NODO
    FROM OID_DB.OID_DB.OID_INVENTARIO_FIJO INV
    INNER JOIN CLAVES_INTENCION C
        ON INV.SUBSCRIBER_ID = C.SUBSCRIBER_ID
       AND INV.FECHA_PROCESO = C.FECHA_INTENCION
    WHERE INV.TIPO_SERVICIO = 'PRIMARIA'
      AND INV.FECHA_PROCESO >= DATE '2026-01-01'
      AND INV.FECHA_PROCESO < DATE '2026-11-01'
)

-- RESULTADO FINAL
SELECT
    'PRIMERA LINEA' AS LINEA,
    I.CANAL,
    I.FECHA_INTENCION,
    I.ID_ORDEN_TRABAJO,
    I.SUBSCRIBER_ID,
    I.CATEGORIZACION_OPERACIONAL_N1,
    I.CATEGORIZACION_OPERACIONAL_N3,
    I.UBICACIONES_ATENCION,
    I.RESULTADO_GESTION,
    I.HERRAMIENTA_RETENCION,
    I.FECHA_IMPACTO,
    I.RNR,

    -- ATRIBUTOS DEL INVENTARIO
    INV.FECHA_ALTA,
    INV.SUBPRODUCTO_HOMOLOGADO,
    INV.ID_DETALLE_PLAN,
    INV.ID_FORMA_PAGO,
    INV.PARROQUIA,
    INV.PROVINCIA,
    INV.CANTON,
    INV.DESCRIPCION_PLAN,
    INV.TECNOLOGIA_HOMOLOGADA,
    INV.ID_IDENTIFICACION,
    INV.FECHA_NACIMIENTO,
    INV.SEGMENTO,
    INV.SEGMENTO_CLIENTE,
    INV.COMPARTICION,
    INV.CODIGO_NODO,

    CASE
        WHEN INV.SUBSCRIBER_ID IS NOT NULL THEN 1
        ELSE 0
    END AS MATCH_INVENTARIO

FROM INTENCIONES I
LEFT JOIN INVENTARIO INV
    ON I.SUBSCRIBER_ID = INV.SUBSCRIBER_ID
   AND I.FECHA_INTENCION = INV.FECHA_PROCESO;
