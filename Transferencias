SELECT
    TIPO_BAJA,
    COUNT(*) AS TOTAL_REGISTROS,
    COUNT(DISTINCT SUBSCRIBER_ID) AS SERVICIOS_UNICOS,
    COUNT(DISTINCT IDENTIFICACION) AS CLIENTES_UNICOS,
    MIN(DATE(FECHA_BAJA)) AS PRIMERA_BAJA,
    MAX(DATE(FECHA_BAJA)) AS ULTIMA_BAJA

FROM SANDBOX.SAC_RET.FIJO_FINAL_ABONADOS_BAJAS_IG

WHERE FAMILIA = 'Internet'
  AND FECHA_BAJA IS NOT NULL
  AND FECHA_BAJA >= DATE '2026-10-01'
  AND FECHA_BAJA < DATE '2026-11-09'

GROUP BY TIPO_BAJA
ORDER BY TIPO_BAJA;
